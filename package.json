{
  "name": "dsh-remote-ssh",
  "version": "0.2.4-aaron.8",
  "description": "Transparent local and Remote SSH workspaces for DeepSeek Harness",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronWu77/dsh-remote-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/Yan-Zero/dsh-remote-ssh/issues"
  },
  "homepage": "https://github.com/Yan-Zero/dsh-remote-ssh#readme",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "main": "lib/host.js",
  "types": "lib/host.d.ts",
  "scripts": {
    "build": "pnpm run typecheck && tsdown",
    "test": "vitest run",
    "test:composition": "pnpm run build && vitest run tests/workspace-deletion.spec.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "prepublishOnly": "pnpm --config.minimum-release-age=0 run check"
  },
  "exports": {
    ".": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./runtime": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./fs": {
      "types": "./lib/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./shell": {
      "types": "./lib/shell.d.ts",
      "default": "./lib/shell.js"
    },
    "./search": {
      "types": "./lib/search.d.ts",
      "default": "./lib/search.js"
    },
    "./manager": {
      "types": "./lib/manager.d.ts",
      "default": "./lib/manager.js"
    },
    "./workspace-registry": {
      "types": "./lib/workspace-registry.d.ts",
      "default": "./lib/workspace-registry.js"
    },
    "./router-fs": {
      "types": "./lib/router-fs.d.ts",
      "default": "./lib/router-fs.js"
    },
    "./router-subprocess": {
      "types": "./lib/router-subprocess.d.ts",
      "default": "./lib/router-subprocess.js"
    },
    "./spill": {
      "types": "./lib/spill.d.ts",
      "default": "./lib/spill.js"
    },
    "./local-bridge": {
      "types": "./lib/local-bridge.d.ts",
      "default": "./lib/local-bridge.js"
    },
    "./shell-transparent": {
      "types": "./lib/shell-transparent.d.ts",
      "default": "./lib/shell-transparent.js"
    },
    "./agent-policy": {
      "types": "./lib/agent-policy.d.ts",
      "default": "./lib/agent-policy.js"
    },
    "./tui": {
      "types": "./lib/tui.d.ts",
      "default": "./lib/tui.js"
    },
    "./web": {
      "types": "./lib/web.d.ts",
      "default": "./lib/web.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "INSTALL.md",
    "UPGRADE.md",
    "docs"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
